{
  "name": "gambrel-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter @gambrel/example-app dev",
    "build": "bun run --filter @gambrel/example-app build",
    "start": "bun run --filter @gambrel/example-app start",
    "typecheck": "bun run --filter '@gambrel/*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}