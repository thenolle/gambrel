{
  "name": "@gambrel/view",
  "version": "0.1.0",
  "description": "VNodes, JSX runtime, server renderer",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-dev-runtime.ts",
      "default": "./src/jsx-dev-runtime.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  }
}