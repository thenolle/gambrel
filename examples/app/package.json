{
  "name": "@gambrel/example-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@gambrel/browser": "workspace:*",
    "@gambrel/bun": "workspace:*",
    "@gambrel/compiler": "workspace:*",
    "@gambrel/core": "workspace:*",
    "@gambrel/reactivity": "workspace:*",
    "@gambrel/router": "workspace:*",
    "@gambrel/ssr": "workspace:*",
    "@gambrel/view": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "latest"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "bun scripts/build.ts",
    "dev": "bun --watch scripts/dev.ts",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "typecheck": "bun run generate && tsc -p tsconfig.json"
  }
}